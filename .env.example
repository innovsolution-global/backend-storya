# ─────────────────────────────────────────────────────────────
#  Storya API — variables d'environnement
#  Copier vers .env puis compléter. Ne jamais commiter .env.
# ─────────────────────────────────────────────────────────────

# --- Serveur ---------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# URL publique de l'API (liens des fichiers locaux, webhooks de paiement)
APP_URL=http://localhost:4000
# URL ou deep link de l'app pour les liens envoyés par email
CLIENT_APP_URL=storya://
# Origines web autorisées (séparées par des virgules). Requis en production.
CORS_ORIGINS=
# Nombre de proxies devant l'API (1 derrière Nginx / Render / Railway)
TRUST_PROXY=0

# --- Base de données -------------------------------------------
# PostgreSQL : postgres://user:password@host:5432/db  (ou pglite:<dossier> en dev)
DATABASE_URL=postgres://storya:storya@127.0.0.1:5432/storya

# --- Authentification ------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=30
BCRYPT_SALT_ROUNDS=12
# Domaine du cookie de refresh token (laisser vide en local)
COOKIE_DOMAIN=

# --- Sécurité / anti brute-force -------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# --- Stockage des fichiers ------------------------------------
# local (dossier uploads/) ou cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=storya
MAX_IMAGE_SIZE_MB=5
MAX_MEDIA_SIZE_MB=100

# --- Emails (sans SMTP_HOST, les emails sont écrits dans les logs) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Storya <no-reply@storya.app>

# --- Notifications push (Firebase Cloud Messaging) ------------
# Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée.
# Mettre le fichier hors du dépôt (ex. backend/secrets/firebase.json, déjà ignoré par Git).
FIREBASE_SERVICE_ACCOUNT_PATH=
# Ou le contenu JSON sur une seule ligne (hébergeurs sans fichiers).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- IA (génération de vidéos) --------------------------------
# GPT : script découpé en scènes (lit aussi les images de l'utilisateur)
OPENAI_API_KEY=
# Clé de secours utilisée si la principale est refusée ou à court de crédit
OPENAI_FALLBACK_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
# Sora : un clip par scène (image de départ envoyée en fichier)
SORA_MODEL=sora-2
# Veo 3.1 via kie.ai (secours si Sora échoue ; les images doivent avoir une URL publique)
KIE_VEO_API_KEY=
# ElevenLabs : voix off (Féminine / Masculine / Enfant)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_MASCULINE=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ENFANT=jBpfuIE2acCO8z3wKNLl
# Mode démo (aucune clé) : montage réel des images de l'utilisateur ou de clips
# libres de droit. auto = actif hors production tant qu'OPENAI_API_KEY est vide.
AI_DEMO_MODE=auto
# Musiques libres de droit : douce.mp3, epique.mp3, joyeuse.mp3 (sinon nappe synthétisée)
MUSIC_DIR=assets/music
# Binaire ffmpeg (par défaut celui du paquet ffmpeg-static)
FFMPEG_PATH=
# Vidéos par jour et par utilisateur
GENERATION_DAILY_LIMIT_FREE=3
GENERATION_DAILY_LIMIT_PREMIUM=20

# --- Paiement (Premium) ---------------------------------------
# mock (développement, tout paiement est accepté) ou cinetpay
PAYMENT_PROVIDER=mock
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Deep link ouvert par CinetPay à la fin du paiement
PAYMENT_RETURN_URL=storya://payment/return

# --- SMS (pas encore utilisé) ---------------------------------
SMS_PROVIDER=console

# --- Seed (npm run seed) --------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
